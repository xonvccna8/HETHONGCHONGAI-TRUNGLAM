# OpenAI (all model choices are configurable)
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-6-astra
OPENAI_FAST_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Multi-agent council
AI_COUNCIL_ENABLED=true
AI_COUNCIL_MAX_CONCURRENCY=3
AI_COUNCIL_TRIGGER=suspicious
AI_COUNCIL_MIN_SIMILARITY=12
AI_AGENT_DOCUMENT_MODEL=gpt-6-astra
AI_AGENT_SIMILARITY_MODEL=gpt-6.1-sol
AI_AGENT_SOURCE_MODEL=gpt-6.1-sol
AI_AGENT_CITATION_MODEL=gpt-6.1-sol
AI_AGENT_COACH_MODEL=gpt-6.1-sol
AI_AGENT_RISK_MODEL=gpt-6-astra
AI_AGENT_REVIEWER_MODEL=gpt-6-astra

# AI-authorship ensemble (OpenAI works immediately; external detectors are optional)
AI_AUTHORSHIP_REVIEW_ENABLED=true
AI_AUTHORSHIP_REVIEW_MODEL=gpt-6-astra
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_SENSITIVITY=2
COPYLEAKS_SANDBOX=false
FAID_API_URL=
FAID_API_TOKEN=
VIET_AI_DETECTOR_API_URL=
VIET_AI_DETECTOR_API_TOKEN=

# Data and background jobs
DATABASE_URL=postgresql://origin:origin@localhost:5432/origin_ai
REDIS_URL=redis://localhost:6379

# Search provider: openai | tavily | serper | none
SEARCH_PROVIDER=openai
SEARCH_API_KEY=
SOURCE_DISCOVERY_MAX_QUERIES=9
SOURCE_DISCOVERY_MAX_SOURCES=12
AI_SEARCH_QUERY_PLANNER_ENABLED=true
AI_SIMILARITY_VERIFIER_ENABLED=true
AI_SIMILARITY_VERIFIER_MODEL=gpt-6-astra

# S3-compatible document storage
S3_ENDPOINT=
S3_BUCKET=origin-ai
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Application and local sign-in
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-long-random-secret
DEMO_LOGIN_EMAIL=demo@origin.ai
DEMO_LOGIN_PASSWORD=origin2026
DATA_RETENTION_DAYS=30
